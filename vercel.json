{
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "headers": [
    {
      "source": "/(.*)\.html",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
    },
    {
      "source": "/(.*)\.svg",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/(.*)\.txt",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
    },
    {
      "source": "/(.*)\.xml",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
    }
  ]
}
